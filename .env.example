# -------------------------------------------------------------
# Supabase & Resend Environment Variables Template
# -------------------------------------------------------------

# 1. Supabase Settings (From Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Resend API Key (From https://resend.com/api-keys)
RESEND_API_KEY=re_123456789abcdef...

# 3. Destination Admin/Owner Email (Where you want to receive bookings)
ADMIN_EMAIL=your-inbox@example.com
