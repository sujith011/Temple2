# -------------------------------------------------------------
# Supabase & Resend Environment Variables Template
# -------------------------------------------------------------

# 1. Supabase Settings (Dashboard -> Project Settings -> API Keys)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_server_only_key

# 2. Resend API Key (From https://resend.com/api-keys)
RESEND_API_KEY=re_replace_with_your_api_key

# 3. Sender from a domain verified in Resend
RESEND_FROM_EMAIL=Kodungallur Temple <forms@yourdomain.com>

# 4. Destination admin email (receives every form submission)
ADMIN_EMAIL=temple-office@yourdomain.com
